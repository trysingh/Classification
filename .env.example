# Copy to .env and uncomment what you need. Every setting in app/config.py can be overridden with the OPENJEV_ prefix.
# OPENJEV_CLASSIFIER_BACKEND=causal_lm        # causal_lm | laya | keyword
# OPENJEV_SYSTEM1_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# OPENJEV_SYSTEM2_MODEL=gemma4:31b-cloud
# OPENJEV_OLLAMA_BASE_URL=http://localhost:11434
# OPENJEV_SYSTEM2_ENABLED=true
# OPENJEV_DATA_DIR=./data
# OPENJEV_ALLOWED_FOLDER_ROOTS=["D:/erp_exports"]   # extra folders batch mode may read (JSON list)
# OPENJEV_DEBUG=false
# OPENJEV_PORT=8000
